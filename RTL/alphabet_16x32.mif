-- ARCADE DISPLAY FONT | 16x32 PIXELS PER CHARACTER | 2 BITS PER PIXEL
-- Supported ASCII: 32..95 (SPACE, punctuation, 0-9, A-Z, [\]^_)
-- Character slot = ASCII_CODE - 32 (6 bits)
-- ADDRESS = {character_slot[5:0], local_y[4:0], local_x[3:0]}
-- 00 = transparent; 01 = outline; 10 = letter fill
-- The ROM holds color CODES, not RGB: choose RGB in your bitmap module.
-- Each slot takes 512 addresses (16 columns x 32 rows), row major.
WIDTH=2;
DEPTH=32768;
ADDRESS_RADIX=HEX;
DATA_RADIX=BIN;
CONTENT BEGIN

